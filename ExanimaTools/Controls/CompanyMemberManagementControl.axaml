<!--
  CompanyMemberManagementControl.axaml
  UI for managing company members: top-level info, tabbed skills/magic/equipment, and equipment assignment from arsenal.
-->
<UserControl x:Class="ExanimaTools.Controls.CompanyMemberManagementControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:ExanimaTools.ViewModels"
    xmlns:models="clr-namespace:ExanimaTools.Models;assembly=ExanimaTools.Models"
    xmlns:exanimaToolsControls="clr-namespace:ExanimaTools.Controls"
    xmlns:local="clr-namespace:ExanimaTools.Controls"
    mc:Ignorable="d">
    <StackPanel Margin="16" Spacing="12">
        <local:BindingProxy x:Name="ArsenalManagerProxy" Data="{Binding ArsenalManagerViewModel, RelativeSource={RelativeSource AncestorType=local:CompanyMemberManagementControl}}"/>
        <StackPanel DataContext="{Binding SelectedCompanyMemberViewModel}">
            <!-- Top-level info -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="Name:" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Width="160" Foreground="Blue"/>
                <TextBlock Text="Role:" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Role}" Width="120"/>
                <TextBlock Text="Rank:" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Rank}" Width="120"/>
            </StackPanel>
            <!-- Tabbed UI for Skills, Magic, Equipment -->
            <TabControl>
                <TabItem Header="Skills">
                    <TextBlock Text="[Skills UI here]"/>
                </TabItem>
                <TabItem Header="Magic">
                    <TextBlock Text="[Magic UI here]"/>
                </TabItem>
                <TabItem Header="Equipment">
                    <StackPanel>
                        <!-- Top Section: Company Arsenal and Personal Pool -->
                        <TextBlock Text="Company Arsenal → Personal Pool" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
                            <!-- Arsenal Tree (left) -->
                            <Border BorderBrush="#444" BorderThickness="1" Padding="8" CornerRadius="4" Width="400" Height="350">
                                <DockPanel>
                                    <TextBlock Text="Company Arsenal" FontWeight="Bold" Margin="0,0,0,8" DockPanel.Dock="Top"/>
                                    <exanimaToolsControls:UniversalTreeControl
                                        TreeItems="{Binding Data.ArsenalTreeViewModel.TreeItems, ElementName=ArsenalManagerProxy}"
                                        SelectedItem="{Binding Data.ArsenalTreeViewModel.SelectedTreeItem, Mode=TwoWay, ElementName=ArsenalManagerProxy}"
                                        VerticalAlignment="Stretch"/>
                                </DockPanel>
                            </Border>
                            <!-- Member Personal Pool Tree (right) -->
                            <Border BorderBrush="#444" BorderThickness="1" Padding="8" CornerRadius="4" Width="400" Height="350">
                                <DockPanel>
                                    <TextBlock Text="Personal Pool" FontWeight="Bold" Margin="0,0,0,8" DockPanel.Dock="Top"/>
                                    <exanimaToolsControls:UniversalTreeControl
                                        TreeItems="{Binding Data.MemberPersonalPoolTreeViewModel.TreeItems, ElementName=ArsenalManagerProxy}"
                                        SelectedItem="{Binding Data.MemberPersonalPoolTreeViewModel.SelectedTreeItem, Mode=TwoWay, ElementName=ArsenalManagerProxy}"
                                        VerticalAlignment="Stretch"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        
                        <!-- Bottom Section: Rank Selection and Loadout -->
                        <TextBlock Text="Rank Loadout" FontWeight="Bold" Margin="0,0,0,8"/>
                        
                        <!-- Rank Loadout Selection Tabs -->
                        <Border Background="#333" 
                                Padding="8" 
                                CornerRadius="4" 
                                Margin="0,0,0,12">
                            <StackPanel Orientation="Vertical" Spacing="8">
                                <TextBlock Text="Select Rank Loadout:" 
                                           FontWeight="SemiBold" 
                                           Foreground="Orange"/>
                                           
                                <!-- Rank Selection Tabs -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <RadioButton GroupName="RankTabs" Content="Inept"
                                                     Command="{Binding Data.SetSelectedRankCommand, ElementName=ArsenalManagerProxy}" 
                                                     CommandParameter="{x:Static models:Rank.Inept}"
                                                     Background="#444" Foreground="White" Padding="12,6"/>
                                        <RadioButton GroupName="RankTabs" Content="Aspirant"
                                                     Command="{Binding Data.SetSelectedRankCommand, ElementName=ArsenalManagerProxy}" 
                                                     CommandParameter="{x:Static models:Rank.Aspirant}"
                                                     Background="#444" Foreground="White" Padding="12,6"/>
                                        <RadioButton GroupName="RankTabs" Content="Novice"
                                                     Command="{Binding Data.SetSelectedRankCommand, ElementName=ArsenalManagerProxy}" 
                                                     CommandParameter="{x:Static models:Rank.Novice}"
                                                     Background="#444" Foreground="White" Padding="12,6"/>
                                        <RadioButton GroupName="RankTabs" Content="Adept"
                                                     IsChecked="True"
                                                     Command="{Binding Data.SetSelectedRankCommand, ElementName=ArsenalManagerProxy}" 
                                                     CommandParameter="{x:Static models:Rank.Adept}"
                                                     Background="#444" Foreground="White" Padding="12,6"/>
                                        <RadioButton GroupName="RankTabs" Content="Expert"
                                                     Command="{Binding Data.SetSelectedRankCommand, ElementName=ArsenalManagerProxy}" 
                                                     CommandParameter="{x:Static models:Rank.Expert}"
                                                     Background="#444" Foreground="White" Padding="12,6"/>
                                        <RadioButton GroupName="RankTabs" Content="Master"
                                                     Command="{Binding Data.SetSelectedRankCommand, ElementName=ArsenalManagerProxy}" 
                                                     CommandParameter="{x:Static models:Rank.Master}"
                                                     Background="#444" Foreground="White" Padding="12,6"/>
                                    </StackPanel>
                                </ScrollViewer>
                                
                                <!-- Current Rank Loadout Display -->
                                <TextBlock Text="{Binding Data.SelectedAssignmentRank, StringFormat='Current Loadout: {0}', ElementName=ArsenalManagerProxy}" 
                                           FontWeight="SemiBold" 
                                           Foreground="Orange"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Rank Loadout Tree (Full Width) -->
                        <Border BorderBrush="#444" BorderThickness="1" Padding="8" CornerRadius="4" Height="300" Margin="0,0,0,16">
                            <DockPanel>
                                <TextBlock Text="{Binding Data.SelectedAssignmentRank, StringFormat='Equipment for Rank: {0}', ElementName=ArsenalManagerProxy}" 
                                           FontWeight="Bold" Margin="0,0,0,8" DockPanel.Dock="Top"/>
                                <exanimaToolsControls:UniversalTreeControl
                                    TreeItems="{Binding Data.MemberRankLoadoutTreeViewModel.TreeItems, ElementName=ArsenalManagerProxy}"
                                    SelectedItem="{Binding Data.MemberRankLoadoutTreeViewModel.SelectedTreeItem, Mode=TwoWay, ElementName=ArsenalManagerProxy}"
                                    VerticalAlignment="Stretch"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </StackPanel>
</UserControl>
